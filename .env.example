# Beispielkonfiguration. Kopiere die Datei nach `.env` und passe die Werte an.
# Alle Werte sind optional – ohne .env laufen sinnvolle Defaults.

# Flask
FLASK_SECRET_KEY=change_me_to_a_random_64_char_string
GK_ADMIN_USER=admin

# Netzwerk (Web-Admin)
GK_HOST=0.0.0.0
GK_PORT=8000

# Sicherheit
GK_SESSION_SECURE=false          # true nur wenn hinter HTTPS
GK_RATE_LIMIT_LOGIN=5/minute
GK_MAX_UPLOAD_MB=5

# Backups
GK_BACKUP_DIR=data/backups
GK_BACKUP_KEEP=20
GK_BACKUP_WEBDAV_URL=
GK_BACKUP_WEBDAV_USER=
GK_BACKUP_WEBDAV_PASS=

# Telegram (kann auch im Web-Admin gesetzt werden)
GK_TELEGRAM_TOKEN=
GK_TELEGRAM_CHAT=

# Logging
GK_LOG_LEVEL=INFO                # DEBUG|INFO|WARNING|ERROR
GK_LOG_JSON=true

# Optional: LAN-URL überschreiben (sonst wird die primäre LAN-IP automatisch erkannt)
GK_PUBLIC_URL=

# Attract-Wetter (open-meteo, kostenlos). Beispiel für Nürnberg: 49.45 / 11.08
GK_LAT=
GK_LON=
